generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                                      String                  @id @default(cuid())
  email                                                   String?                 @unique
  password                                                String
  nombre                                                  String
  apellido                                                String
  rol                                                     Role                    @default(RECEPCIONISTA)
  especialidad                                            String?
  numeroDocumento                                         String?
  telefono                                                String?
  activo                                                  Boolean                 @default(true)
  createdAt                                               DateTime                @default(now())
  updatedAt                                               DateTime                @updatedAt
  firmaBase64                                             String?
  registroMedico                                          String?
  registroProfesional                                     String?
  tipoDocumento                                           String?
  username                                                String?                 @unique
  empresaId                                               String?
  perfilId                                                String?
  sedeId                                                  String?
  auditLogs                                               AuditLog[]
  bloqueosAgenda                                          BloqueDisponibilidad[]
  citasAsignadas                                          Cita[]
  cotizaciones                                            Cotizacion[]
  crmLeads                                                CrmLead[]               @relation("CrmLeadCreador")
  DelegacionTemporal_DelegacionTemporal_delegadoIdToUser  DelegacionTemporal[]    @relation("DelegacionTemporal_delegadoIdToUser")
  DelegacionTemporal_DelegacionTemporal_deleganteIdToUser DelegacionTemporal[]    @relation("DelegacionTemporal_deleganteIdToUser")
  disponibilidades                                        DisponibilidadMedico[]
  DispositivoAutorizado                                   DispositivoAutorizado[]
  GrupoUsuario                                            GrupoUsuario[]
  historiasEditadas                                       HistoriaClinica[]
  ingresosFacturacion                                     Ingreso[]
  MfaConfig                                               MfaConfig?
  odontogramas                                            Odontograma[]
  pacientesCreados                                        Paciente[]
  PermisoRecurso                                          PermisoRecurso[]
  procedimientosRealizados                                Procedimiento[]
  SesionActiva                                            SesionActiva[]
  Empresa                                                 Empresa?                @relation(fields: [empresaId], references: [id])
  Perfil                                                  Perfil?                 @relation(fields: [perfilId], references: [id])
  Sede                                                    Sede?                   @relation(fields: [sedeId], references: [id])
  UsuarioIamRol                                           UsuarioIamRol[]
  contratosCreados                                        Contrato[]              @relation("ContratoCreadoPor")

  @@index([rol])
  @@index([email])
  @@index([empresaId])
  @@index([perfilId])
  @@index([sedeId])
}

model Especialidad {
  id                    String         @id @default(cuid())
  codigo                String         @unique
  nombre                String         @unique
  descripcion           String?
  aplicaAnestesia       Boolean        @default(false)
  aplicaPediatria       Boolean        @default(false)
  aplicaCirugia         Boolean        @default(false)
  aplicaInstrumentacion Boolean        @default(false)
  aplicaMedicoFamiliar  Boolean        @default(false)
  estado                Boolean        @default(true)
  usuarioCreacion       String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime
  Preparacion           Preparacion[]
  TipoConsulta          TipoConsulta[]

  @@index([estado])
}

model Paciente {
  id                    String                    @id @default(cuid())
  numeroDocumento       String
  tipoDocumento         String
  nombreCompleto        String
  fechaNacimiento       DateTime
  genero                String
  telefonos             String[]
  email                 String?
  whatsapp              String?
  direccion             String?
  ciudad                String?
  fotoPerfil            String?
  estado                String                    @default("ACTIVO")
  creadoPor             String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  alergias              Alergia[]
  alertas               Alerta[]
  antecedentes          AntecedentesQuirurgicos[]
  citas                 Cita[]
  consentimientos       Consentimiento[]
  cotizaciones          Cotizacion[]
  crmLeads              CrmLead[]
  facturas              Factura[]
  fotos                 FotoClinica[]
  historiasClinicas     HistoriaClinica[]
  ingresos              Ingreso[]
  mapaCorporal          MapaCorporal[]
  medicacionActual      Medicamento[]
  odontoEvoluciones     OdontoEvolucion[]
  odontoPlanItems       OdontoPlanItem[]
  odontogramas          Odontograma[]
  creadoBy              User?                     @relation(fields: [creadoPor], references: [id])
  procedimientos        Procedimiento[]
  seguimientos          SeguimientoPostOp[]
  transacciones         Transaccion[]
  contratosBeneficiario ContratoBeneficiario[]
  inscripcionesPE       InscripcionPrograma[]

  @@unique([numeroDocumento, tipoDocumento])
  @@index([nombreCompleto])
  @@index([estado])
  @@index([email])
  @@index([creadoPor])
}

model Alergia {
  id         String   @id @default(cuid())
  pacienteId String
  nombre     String
  severidad  String
  reaccion   String?
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model Medicamento {
  id         String    @id @default(cuid())
  pacienteId String?
  nombre     String
  dosis      String
  frecuencia String
  indicacion String
  activo     Boolean   @default(true)
  paciente   Paciente? @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model AntecedentesQuirurgicos {
  id             String   @id @default(cuid())
  pacienteId     String
  procedimiento  String
  fecha          DateTime
  complicaciones String?
  cirujano       String?
  paciente       Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model Procedimiento {
  id                      String                @id @default(cuid())
  pacienteId              String
  medicoId                String
  tipoProcedimiento       String
  nombreProcedimiento     String
  descripcion             String?
  fechaProgramada         DateTime
  fechaRealizada          DateTime?
  duracionEstimada        Int
  duracionReal            Int?
  estado                  String                @default("PENDIENTE")
  notasPreoperatorio      String?
  notasOperatorio         String?
  complicaciones          String[]
  resultadoVisualEsperado String?
  resultadoVisualActual   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  codigoCUPS              String?
  alertas                 Alerta[]
  checklistsCompletados   ChecklistCompletado[]
  consentimientos         Consentimiento[]
  fotos                   FotoClinica[]
  historias               HistoriaClinica[]
  mapaCorporal            MapaCorporal[]
  procedimientoCUPS       ProcedimientoCUPS?    @relation(fields: [codigoCUPS], references: [codigoCUPS])
  medico                  User                  @relation(fields: [medicoId], references: [id])
  paciente                Paciente              @relation(fields: [pacienteId], references: [id])
  seguimientos            SeguimientoPostOp[]

  @@index([pacienteId])
  @@index([medicoId])
  @@index([codigoCUPS])
  @@index([estado])
  @@index([fechaProgramada])
}

model HistoriaClinica {
  id                 String             @id @default(cuid())
  pacienteId         String
  procedimientoId    String?
  tipoHistoria       String
  contenido          Json
  version            Int                @default(1)
  editadoPor         String
  fechaCreacion      DateTime           @default(now())
  fechaUltimaEdicion DateTime           @updatedAt
  firmadoPorMedico   Boolean            @default(false)
  fechaFirma         DateTime?
  hashIntegridad     String
  plantillaId        String?
  usuario            User               @relation(fields: [editadoPor], references: [id])
  paciente           Paciente           @relation(fields: [pacienteId], references: [id])
  plantilla          PlantillaTemplate? @relation(fields: [plantillaId], references: [id])
  procedimiento      Procedimiento?     @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([editadoPor])
  @@index([procedimientoId])
  @@index([plantillaId])
  @@index([tipoHistoria])
  @@index([fechaCreacion])
}

model PlantillaProcedimiento {
  id                      String   @id @default(cuid())
  codigoCups              String   @unique
  nombreProcedimiento     String
  categoria               String
  descripcion             String?
  camposObligatorios      Json
  camposOpcionales        Json
  riesgosAuto             String[]
  complicacionesEsperadas String[]
  medicacionRecomendada   Json
  postoperatorioPorDias   Json
  consentimientoTemplate  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([categoria])
}

model Consentimiento {
  id               String        @id @default(cuid())
  pacienteId       String
  procedimientoId  String
  plantillaId      String
  contenidoHtml    String
  contenidoPdfUrl  String?
  firmaDigitalUrl  String?
  selfieUrl        String?
  fechaFirma       DateTime?
  ipDispositivo    String?
  navegador        String?
  sistemaOperativo String?
  geolocation      Json?
  firmado          Boolean       @default(false)
  hashIntegridad   String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  paciente         Paciente      @relation(fields: [pacienteId], references: [id])
  procedimiento    Procedimiento @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([procedimientoId])
  @@index([firmado])
}

model FotoClinica {
  id                 String         @id @default(cuid())
  pacienteId         String
  procedimientoId    String?
  tipo               String
  diasPostOperatorio Int?
  urlOriginal        String
  urlComprimida      String
  urlMiniatura       String
  metadatos          Json?
  anotaciones        Json?
  visibleAlPaciente  Boolean        @default(false)
  fechaCaptura       DateTime
  createdAt          DateTime       @default(now())
  paciente           Paciente       @relation(fields: [pacienteId], references: [id])
  procedimiento      Procedimiento? @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([procedimientoId])
  @@index([tipo])
}

model MapaCorporal {
  id                 String         @id @default(cuid())
  pacienteId         String
  procedimientoId    String?
  fechaEvaluacion    DateTime
  zonasMarcadas      Json
  edemaZonas         Json
  fibrosisZonas      Json
  dolorZonas         Json
  colorIndicator     String?
  anotacionesClinics String?
  evaluadoPor        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  paciente           Paciente       @relation(fields: [pacienteId], references: [id])
  procedimiento      Procedimiento? @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([procedimientoId])
}

model SeguimientoPostOp {
  id                          String        @id @default(cuid())
  pacienteId                  String
  procedimientoId             String
  diaPostOp                   Int
  fechaPrevista               DateTime
  fechaCompletada             DateTime?
  tipoSeguimiento             String
  checklistPreguntas          Json
  checklistRespuestas         Json?
  reportarComplicacion        Boolean       @default(false)
  descripcionComplicacion     String?
  alertasGeneradas            Json[]
  completado                  Boolean       @default(false)
  notificacionWhatsappEnviada Boolean       @default(false)
  createdAt                   DateTime      @default(now())
  paciente                    Paciente      @relation(fields: [pacienteId], references: [id])
  procedimiento               Procedimiento @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([procedimientoId])
  @@index([diaPostOp])
  @@index([completado])
}

model Alerta {
  id                String         @id @default(cuid())
  pacienteId        String
  procedimientoId   String?
  tipoAlerta        String
  severidad         String
  descripcion       String
  accionRecomendada String
  iaDetectada       Boolean        @default(false)
  resuelta          Boolean        @default(false)
  fechaResolucion   DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  paciente          Paciente       @relation(fields: [pacienteId], references: [id])
  procedimiento     Procedimiento? @relation(fields: [procedimientoId], references: [id])

  @@index([pacienteId])
  @@index([severidad])
  @@index([resuelta])
}

model Cita {
  id                   String    @id @default(cuid())
  pacienteId           String
  medicoId             String
  tipoCita             String
  fechaHora            DateTime
  duracionMinutos      Int       @default(60)
  estado               String    @default("PENDIENTE")
  motivo               String?
  notas                String?
  recordatorioWhatsapp Boolean   @default(false)
  asistencia           Boolean?
  salaQuirofanoId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  entidadSalud         String?
  medico               User      @relation(fields: [medicoId], references: [id])
  paciente             Paciente  @relation(fields: [pacienteId], references: [id])
  ingresos             Ingreso[]

  @@index([pacienteId])
  @@index([medicoId])
  @@index([fechaHora])
  @@index([estado])
}

model Transaccion {
  id              String   @id @default(cuid())
  pacienteId      String
  procedimientoId String?
  tipo            String
  concepto        String
  monto           Float
  moneda          String   @default("COP")
  metodoPago      String
  referenciaPago  String?
  estado          String   @default("PENDIENTE")
  reciboUrl       String?
  creadoPor       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paciente        Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@index([estado])
}

model AuditLog {
  id            String   @id @default(cuid())
  usuarioId     String
  tablaAfectada String
  registroId    String
  tipoOperacion String
  datosAntes    Json?
  datosDespues  Json?
  ipOrigen      String?
  userAgent     String?
  razon         String?
  timestamp     DateTime @default(now())
  usuario       User     @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tablaAfectada])
  @@index([timestamp])
}

model Integracion {
  id                        String    @id @default(cuid())
  tipo                      String
  credencialesEncriptadas   String
  activa                    Boolean   @default(true)
  fechaUltimaSincronizacion DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model ProcedimientoCUPS {
  id                      String                  @id @default(cuid())
  codigoCUPS              String                  @unique
  nombre                  String
  descripcion             String?
  tipoCategoria           String
  riesgoNivel             String
  diasSeguimiento         Int                     @default(30)
  datosAdicionales        Json?
  activo                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  checklistTemplates      ChecklistTemplate[]
  consentimientosTemplate ConsentimientoTemplate?
  plantillas              PlantillaTemplate[]
  procedimientosClinica   Procedimiento[]

  @@index([codigoCUPS])
  @@index([tipoCategoria])
  @@index([activo])
}

model PlantillaTemplate {
  id                   String            @id @default(cuid())
  codigoCUPS           String
  nombre               String
  tipo                 String
  descripcion          String?
  seccionesJSON        Json
  requiereSignatura    Boolean           @default(false)
  requiereFoto         Boolean           @default(false)
  requiereMapaCorporal Boolean           @default(false)
  ordenVisualizacion   Int               @default(1)
  activa               Boolean           @default(true)
  creadoPor            String?
  actualizadoPor       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  historiasClinicas    HistoriaClinica[]
  procedimiento        ProcedimientoCUPS @relation(fields: [codigoCUPS], references: [codigoCUPS], onDelete: Cascade)

  @@unique([codigoCUPS, tipo])
  @@index([codigoCUPS])
  @@index([tipo])
}

model ChecklistTemplate {
  id                     String            @id @default(cuid())
  codigoCUPS             String
  fase                   String
  nombre                 String
  itemsJSON              Json
  alertasAutomaticasJSON Json?
  activo                 Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  procedimiento          ProcedimientoCUPS @relation(fields: [codigoCUPS], references: [codigoCUPS], onDelete: Cascade)

  @@unique([codigoCUPS, fase])
  @@index([codigoCUPS])
}

model ConsentimientoTemplate {
  id                  String            @id @default(cuid())
  codigoCUPS          String            @unique
  titulo              String
  seccionesJSON       Json
  riesgosJSON         Json
  recomendacionesJSON Json?
  activo              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  procedimiento       ProcedimientoCUPS @relation(fields: [codigoCUPS], references: [codigoCUPS], onDelete: Cascade)

  @@index([codigoCUPS])
}

model ConfiguracionSistema {
  id          String   @id @default(cuid())
  clave       String   @unique
  valor       Json
  descripcion String?
  updatedAt   DateTime @updatedAt

  @@index([clave])
}

model ChecklistCompletado {
  id              String        @id @default(cuid())
  procedimientoId String
  templateId      String
  fase            String
  respuestasJSON  Json?
  completadoEn    DateTime?
  completadoPor   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  procedimiento   Procedimiento @relation(fields: [procedimientoId], references: [id], onDelete: Cascade)

  @@index([procedimientoId])
  @@index([completadoEn])
}

model DisponibilidadMedico {
  id           String    @id @default(cuid())
  medicoId     String
  diaSemana    Int
  horaInicio   String
  horaFin      String
  duracionSlot Int       @default(60)
  sede         String?   @default("Principal")
  tipoAtencion String?   @default("CONSULTA")
  consultorio  String?
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  fechaDesde   DateTime?
  fechaHasta   DateTime?
  medico       User      @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@index([medicoId])
  @@index([diaSemana])
}

model BloqueDisponibilidad {
  id          String   @id @default(cuid())
  medicoId    String
  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String?  @default("Bloqueo")
  todoElDia   Boolean  @default(true)
  createdAt   DateTime @default(now())
  medico      User     @relation(fields: [medicoId], references: [id], onDelete: Cascade)

  @@index([medicoId])
  @@index([fechaInicio])
}

model CampoPaciente {
  id              String   @id
  nombre          String   @unique
  etiqueta        String
  seccion         String
  tipoCampo       String   @default("text")
  esVisible       Boolean  @default(true)
  esObligatorio   Boolean  @default(false)
  esPersonalizado Boolean  @default(false)
  opciones        Json?
  placeholder     String?
  orden           Int      @default(0)
  estado          Boolean  @default(true)
  usuarioCreacion String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([esPersonalizado])
  @@index([esVisible])
  @@index([seccion])
}

model Cargo {
  id                String              @id
  codigo            String              @unique
  nombre            String
  descripcion       String?
  tipo              String              @default("CONSULTA")
  valor             Float               @default(0)
  unidad            String?
  codigoReferencia  String?
  aplicaIva         Boolean             @default(false)
  tasaIva           Float               @default(0)
  esObligatorio     Boolean             @default(false)
  aplicaPYP         Boolean             @default(false)
  estado            Boolean             @default(true)
  usuarioCreacion   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  DepartamentoCargo DepartamentoCargo[]

  @@index([estado])
  @@index([tipo])
}

model ConfigServicioConsulta {
  id                String             @id
  tipoConsultaId    String
  servicioId        String
  esPrincipal       Boolean            @default(false)
  generaAutomatico  Boolean            @default(false)
  requiereOrden     Boolean            @default(false)
  centroOperacionId String?
  cuentaContable    String?
  hcModuloId        String?
  usuarioCreacion   String?
  createdAt         DateTime           @default(now())
  servicio          ServicioFacturable @relation(fields: [servicioId], references: [id])
  tipoConsulta      TipoConsulta       @relation(fields: [tipoConsultaId], references: [id], onDelete: Cascade)

  @@unique([tipoConsultaId, servicioId])
  @@index([servicioId])
  @@index([tipoConsultaId])
}

model Departamento {
  id                String              @id
  codigo            String              @unique
  nombre            String
  descripcion       String?
  estado            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  DepartamentoCargo DepartamentoCargo[]
  ReglaOperativa    ReglaOperativa[]
  TipoConsulta      TipoConsulta[]

  @@index([estado])
}

model DepartamentoCargo {
  id                     String       @id
  departamentoId         String
  cargoId                String
  permiteSeleccion       Boolean      @default(true)
  manejaInsumos          Boolean      @default(false)
  cumplimientoAutomatico Boolean      @default(false)
  tomadoAutomatico       Boolean      @default(false)
  interfaceExterno       Boolean      @default(false)
  generaOrden            Boolean      @default(false)
  liquidaHonorarios      Boolean      @default(false)
  cumplimientoParcial    Boolean      @default(false)
  manejaCentroCosto      Boolean      @default(false)
  usuarioCreacion        String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  Cargo                  Cargo        @relation(fields: [cargoId], references: [id])
  Departamento           Departamento @relation(fields: [departamentoId], references: [id], onDelete: Cascade)

  @@unique([departamentoId, cargoId])
  @@index([departamentoId])
}

model HCModulo {
  id                      String         @id
  codigo                  String         @unique
  nombre                  String
  descripcion             String?
  activo                  Boolean        @default(true)
  tipoFinalidad           String?
  tipoRips                String?
  parametrosConfiguracion Json?
  programaId              String?
  usuarioCreacion         String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime
  TipoConsulta            TipoConsulta[]

  @@index([activo])
}

model ListaValor {
  id        String   @id
  grupo     String
  valor     String
  etiqueta  String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@unique([grupo, valor])
  @@index([grupo])
}

model MotivoCita {
  id          String   @id
  nombre      String
  descripcion String?
  tipo        String   @default("consulta")
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([activo])
  @@index([tipo])
}

model ParametroSistema {
  id        String   @id
  grupo     String
  clave     String
  valor     String   @default("")
  etiqueta  String
  tipo      String   @default("text")
  orden     Int      @default(0)
  estado    Boolean  @default(true)
  updatedAt DateTime

  @@unique([grupo, clave])
  @@index([grupo])
}

model Preparacion {
  id              String        @id
  nombre          String
  descripcion     String?
  tipo            String        @default("consulta")
  especialidadId  String?
  tipoConsultaId  String?
  estado          Boolean       @default(true)
  usuarioCreacion String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  especialidad    Especialidad? @relation(fields: [especialidadId], references: [id])
  tipoConsulta    TipoConsulta? @relation(fields: [tipoConsultaId], references: [id])

  @@index([estado])
  @@index([tipoConsultaId])
}

model ReglaOperativa {
  id                     String             @id
  departamentoId         String
  servicioId             String
  permiteSeleccion       Boolean            @default(true)
  manejaInsumos          Boolean            @default(false)
  generaOrden            Boolean            @default(false)
  liquidaHonorarios      Boolean            @default(false)
  cumplimientoAutomatico Boolean            @default(false)
  tomadoAutomatico       Boolean            @default(false)
  cumplimientoParcial    Boolean            @default(false)
  manejaCentroCosto      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime
  departamento           Departamento       @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  servicio               ServicioFacturable @relation(fields: [servicioId], references: [id])

  @@unique([departamentoId, servicioId])
  @@index([departamentoId])
}

model ServicioFacturable {
  id                     String                   @id
  codigoCups             String                   @unique
  nombre                 String
  descripcion            String?
  categoria              String?
  subcategoria           String?
  tipoServicio           String?
  nivelComplejidad       String?
  conceptoRips           String?
  precioBase             Float                    @default(0)
  requiereCantidad       Boolean                  @default(false)
  esHonorario            Boolean                  @default(false)
  esPOS                  Boolean                  @default(false)
  estado                 Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  ConfigServicioConsulta ConfigServicioConsulta[]
  ReglaOperativa         ReglaOperativa[]

  @@index([categoria])
  @@index([estado])
}

model TipoConsulta {
  id                       String                   @id
  nombre                   String
  descripcion              String?
  especialidadId           String?
  departamentoId           String?
  hcModuloId               String?
  requiereCaja             Boolean                  @default(false)
  manejaAnestesia          Boolean                  @default(false)
  permiteAgendamiento      Boolean                  @default(true)
  controlaTiempoCita       Boolean                  @default(false)
  abreHistoriaClinica      Boolean                  @default(true)
  permiteCargosAdicionales Boolean                  @default(false)
  esProgramaPYP            Boolean                  @default(false)
  manejaProtocolos         Boolean                  @default(false)
  clasificacion            String                   @default("CONSULTA")
  esPsicologia             Boolean                  @default(false)
  duracionMinutos          Int                      @default(30)
  bodegaId                 String?
  estado                   Boolean                  @default(true)
  usuarioCreacion          String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime
  serviciosConfig          ConfigServicioConsulta[]
  preparaciones            Preparacion[]
  departamento             Departamento?            @relation(fields: [departamentoId], references: [id])
  especialidad             Especialidad?            @relation(fields: [especialidadId], references: [id])
  hcModulo                 HCModulo?                @relation(fields: [hcModuloId], references: [id])

  @@index([especialidadId])
  @@index([estado])
}

model TipoConsultorio {
  id               String   @id
  codigo           String   @unique
  tipoConsultorio  String
  descripcion      String?
  indiceAutomatico Int?
  estado           Boolean  @default(true)
  usuarioCreacion  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime

  @@index([estado])
}

model Cotizacion {
  id                  String    @id @default(cuid())
  pacienteId          String
  medicoId            String
  citaId              String?
  descripcionServicio String
  lineas              Json
  subtotal            Float
  descuentoPorcentaje Float     @default(0)
  descuentoValor      Float     @default(0)
  total               Float
  notasAdicionales    String?
  vigenciaHasta       DateTime
  estado              String    @default("GENERADA")
  creadoEn            DateTime  @default(now())
  aceptadaEn          DateTime?
  rechazadaEn         DateTime?
  medico              User      @relation(fields: [medicoId], references: [id])
  paciente            Paciente  @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@index([medicoId])
  @@index([estado])
  @@index([creadoEn])
}

model CrmLead {
  id                String    @id @default(cuid())
  nombre            String
  telefono          String?
  email             String?
  procedimientos    String[]
  etapa             String    @default("NUEVO_LEAD")
  calificacion      String    @default("COLD")
  valorEstimado     Float     @default(0)
  origen            String?
  notas             String?
  observaciones     String?
  tags              String[]
  pacienteId        String?
  creadoPor         String?
  proximoContacto   DateTime?
  ultimaInteraccion DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  creador           User?     @relation("CrmLeadCreador", fields: [creadoPor], references: [id])
  paciente          Paciente? @relation(fields: [pacienteId], references: [id])

  @@index([etapa])
  @@index([calificacion])
  @@index([pacienteId])
  @@index([creadoPor])
  @@index([proximoContacto])
  @@index([ultimaInteraccion])
}

model CupsCodigo {
  id            String        @id @default(cuid())
  codigo        String        @unique
  codigoFormato String
  nivel         CupsNivel
  descripcion   String
  seccion       String
  capitulo      String
  grupo         String
  subgrupo      String?
  categoria     String?
  subcategoria  String?
  parentId      String?
  incluye       String?
  excluye       String?
  nota          String?
  esFacturable  Boolean       @default(false)
  activo        Boolean       @default(true)
  version       String        @default("Resolucion 2706 de 2025")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  parent        CupsCodigo?   @relation("CupsJerarquia", fields: [parentId], references: [id], onDelete: Cascade)
  hijos         CupsCodigo[]  @relation("CupsJerarquia")
  cargos        TarifaCargo[]

  @@index([nivel])
  @@index([seccion])
  @@index([capitulo])
  @@index([grupo])
  @@index([parentId])
  @@index([esFacturable])
  @@index([activo])
}

model TarifaGrupo {
  id        String        @id @default(cuid())
  codigo    String        @unique
  nombre    String
  activo    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cargos    TarifaCargo[]
  tipos     TarifaTipo[]

  @@index([activo])
}

model TarifaTipo {
  id        String        @id @default(cuid())
  codigo    String
  nombre    String
  activo    Boolean       @default(true)
  grupoId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  cargos    TarifaCargo[]
  grupo     TarifaGrupo   @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@unique([grupoId, codigo])
  @@index([grupoId])
  @@index([activo])
}

model TarifaCargo {
  id                String                     @id @default(cuid())
  codigo            String                     @unique
  descripcion       String
  cupsCodigoId      String?
  cupsCodigoStr     String?
  grupoId           String?
  tipoId            String?
  nivel             String?
  tipoUnidad        String?
  conceptoRips      String?
  activo            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  cuentaItems       CuentaItem[]
  odontoSugerencias OdontoHallazgoSugerencia[]
  odontoPlanItems   OdontoPlanItem[]
  cupsCodigo        CupsCodigo?                @relation(fields: [cupsCodigoId], references: [id])
  grupo             TarifaGrupo?               @relation(fields: [grupoId], references: [id])
  tipo              TarifaTipo?                @relation(fields: [tipoId], references: [id])
  items             TarifaItem[]

  @@index([cupsCodigoId])
  @@index([grupoId])
  @@index([tipoId])
  @@index([activo])
}

model Tarifario {
  id            String       @id @default(cuid())
  codigo        String       @unique
  nombre        String
  descripcion   String?
  tipo          String?
  baseId        String?
  porcentaje    Float?
  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         TarifaItem[]
  base          Tarifario?   @relation("TarifarioBase", fields: [baseId], references: [id])
  derivados     Tarifario[]  @relation("TarifarioBase")

  @@index([activo])
  @@index([baseId])
}

model TarifaItem {
  id          String      @id @default(cuid())
  tarifarioId String
  cargoId     String
  precio      Float
  activo      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cargo       TarifaCargo @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  tarifario   Tarifario   @relation(fields: [tarifarioId], references: [id], onDelete: Cascade)

  @@unique([tarifarioId, cargoId])
  @@index([tarifarioId])
  @@index([cargoId])
}

model Ingreso {
  id            String    @id @default(cuid())
  numero        Int       @unique @default(autoincrement())
  pacienteId    String
  citaId        String?
  medicoId      String?
  tipoIngreso   String    @default("AMBULATORIO")
  entidad       String?
  plan          String?
  estado        String    @default("ACTIVO")
  fechaIngreso  DateTime  @default(now())
  fechaEgreso   DateTime?
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  cuentas       Cuenta[]
  cita          Cita?     @relation(fields: [citaId], references: [id])
  medico        User?     @relation(fields: [medicoId], references: [id])
  paciente      Paciente  @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@index([citaId])
  @@index([medicoId])
  @@index([tipoIngreso])
  @@index([fechaIngreso])
  @@index([estado])
}

model Cuenta {
  id            String       @id @default(cuid())
  numero        Int          @unique @default(autoincrement())
  ingresoId     String
  estado        String       @default("ABIERTA")
  observaciones String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ingreso       Ingreso      @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  items         CuentaItem[]
  factura       Factura?

  @@index([ingresoId])
  @@index([estado])
}

model CuentaItem {
  id                             String       @id @default(cuid())
  cuentaId                       String
  cargoId                        String?
  codigo                         String?
  descripcion                    String
  departamento                   String?
  cantidad                       Float        @default(1)
  precioUnitario                 Float        @default(0)
  valorTotal                     Float        @default(0)
  // Campos RIPS (Resolución 2275/2023), diligenciados por ítem para poder
  // pre-validar la cuenta antes de facturar. El componente (tipoRips)
  // determina cuáles de estos campos son exigibles — ver ripsValidacionService.
  tipoRips                       String? // AC=Consulta, AP=Procedimiento, AH=Hospitalizacion, AU=Urgencias, AT=Otros servicios
  codDiagnosticoPrincipal        String?
  tipoDiagnosticoPrincipal       String? // 01 Impresion diagnostica, 02 Confirmado nuevo, 03 Confirmado repetido
  finalidadTecnologiaSalud       String?
  causaMotivoAtencion            String?
  viaIngresoServicioSalud        String?
  modalidadGrupoServicioTecSal   String?
  numAutorizacion                String?
  codPrestador                   String?
  conceptoRecaudo                String? // 01-05, define si aplica copago/cuota moderadora
  valorPagoModerador             Float?
  // Específicos de Procedimientos (AP)
  ambitoRealizacionProcedimiento String? // 01 Ambulatorio, 02 Hospitalario, 03 Urgencias
  viaAccesoQuirurgico            String?
  numMipres                      String?
  // Específicos de Hospitalización (AH) / Urgencias (AU)
  fechaAtencion                  DateTime?
  fechaIngreso                   DateTime?
  fechaSalida                    DateTime?
  estadoSalida                   String? // 1 Vivo, 2 Muerto
  destinoUsuarioEgreso           String?
  codDiagnosticoIngreso          String?
  codDiagnosticoSalida           String?
  codDiagnosticoMuerte           String?
  // Específico de Otros Servicios (AT)
  tipoOtroServicio               String?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  cargo                          TarifaCargo? @relation(fields: [cargoId], references: [id])
  cuenta                         Cuenta       @relation(fields: [cuentaId], references: [id], onDelete: Cascade)

  @@index([cuentaId])
  @@index([cargoId])
}

model Factura {
  id            String   @id @default(cuid())
  numero        Int      @unique @default(autoincrement())
  prefijo       String   @default("FE")
  cuentaId      String   @unique
  pacienteId    String
  entidad       String?
  plan          String?
  subtotal      Float    @default(0)
  total         Float    @default(0)
  estado        String   @default("EMITIDA")
  observaciones String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cuenta        Cuenta   @relation(fields: [cuentaId], references: [id])
  paciente      Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@index([estado])
  @@index([fecha])
}

// ─────────────────────────────────────────────
//  MÓDULO DE CONTRATACIÓN
// ─────────────────────────────────────────────

// Empresa cliente/contratante (aseguradoras, convenios, y la propia clínica
// vía esClinicaPropia). Distinta de Empresa (tenant/organización de IAM,
// más abajo en este archivo) — colisión de nombres detectada al mergear
// contratación con el módulo de IAM/seguridad; se renombra esta para no
// tocar la infraestructura de multi-tenancy ya migrada.
model EmpresaContratante {
  id                String     @id @default(cuid())
  razonSocial       String
  nombreComercial   String?
  nit               String     @unique
  tipo              String     @default("EMPRESA") // EMPRESA, ASEGURADORA, CONVENIO, CLINICA_PROPIA
  contactoNombre    String?
  contactoCargo     String?
  contactoEmail     String?
  contactoTelefono  String?
  direccion         String?
  ciudad            String?
  estado            Boolean    @default(true)
  esClinicaPropia   Boolean    @default(false)
  sitioWeb          String?
  regimenTributario String?
  logoUrl           String?
  contratos         Contrato[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([nit])
  @@index([estado])
  @@map("Empresa")
}

model Contrato {
  id                  String                 @id @default(cuid())
  numero              Int                    @unique @default(autoincrement())
  descripcion         String
  empresaId           String
  empresa             EmpresaContratante     @relation(fields: [empresaId], references: [id])
  tipo                String                 @default("CONVENIO") // CONVENIO, CORPORATIVO, COLECTIVO
  estado              String                 @default("BORRADOR") // BORRADOR, ACTIVO, SUSPENDIDO, VENCIDO, CANCELADO
  fechaInicio         DateTime
  fechaFin            DateTime
  montoTotal          Float?
  montoMensual        Float?
  diasCredito         Int                    @default(30)
  porcentajeDescuento Float                  @default(0)
  porcentajeCobertura Float                  @default(100)
  observaciones       String?
  // Vinculación FEV-RIPS/Registro de Contratos SISPRO: es obligatorio uno de los dos.
  tieneCucon          Boolean                @default(false)
  codigoCucon         String? // hash SHA-256 de 64 caracteres hex, requerido si tieneCucon = true
  facturaSinContrato  String? // codigo 01-06, requerido si tieneCucon = false (ver FACTURA_SIN_CONTRATO)
  creadoPorId         String
  creadoPor           User                   @relation("ContratoCreadoPor", fields: [creadoPorId], references: [id])
  tarifas             ContratoTarifa[]
  paquetes            ContratoPaquete[]
  beneficiarios       ContratoBeneficiario[]
  excepciones         ContratoExcepcion[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([empresaId])
  @@index([estado])
  @@index([fechaFin])
  @@index([fechaInicio])
  @@index([tipo])
  @@index([creadoPorId])
}

model ContratoTarifa {
  id                  String              @id @default(cuid())
  contratoId          String
  contrato            Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  codigoCUPS          String
  descripcionCUPS     String
  precioBase          Float
  precioNegociado     Float
  porcentajeDescuento Float               @default(0)
  porcentajeCobertura Float               @default(100)
  activo              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  excepciones         ContratoExcepcion[]

  @@unique([contratoId, codigoCUPS])
  @@index([contratoId])
  @@index([codigoCUPS])
}

// Rangos por tipo de afiliado, copagos y cuotas moderadoras (equivalente a las
// "excepciones adicionales" del sistema IPSOFT: reglas finas sobre una tarifa
// o sobre todo el contrato, según edad/sexo/tipo de afiliado).
model ContratoExcepcion {
  id                        String          @id @default(cuid())
  contratoId                String
  contrato                  Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tarifaId                  String? // null = aplica a todo el contrato; si se define, aplica solo a esa tarifa/CUPS
  tarifa                    ContratoTarifa? @relation(fields: [tarifaId], references: [id], onDelete: Cascade)
  tipoAfiliado              String          @default("AMBOS") // TITULAR, BENEFICIARIO, COTIZANTE, AMBOS
  edadMinima                Int?
  edadMaxima                Int?
  sexo                      String          @default("AMBOS") // M, F, AMBOS
  aplicaCopago              Boolean         @default(false)
  porcentajeCopago          Float           @default(0)
  aplicaCuotaModeradora     Boolean         @default(false)
  porcentajeCuotaModeradora Float           @default(0)
  numVecesMaximo            Int?
  excluyePorEdad            Boolean         @default(false)
  excluyePorCotizar         Boolean         @default(false)
  activo                    Boolean         @default(true)
  observaciones             String?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  @@index([contratoId])
  @@index([tarifaId])
}

model ContratoPaquete {
  id          String                @id @default(cuid())
  contratoId  String
  contrato    Contrato              @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  nombre      String
  descripcion String?
  precio      Float
  activo      Boolean               @default(true)
  items       ContratoPaqueteItem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([contratoId])
}

model ContratoPaqueteItem {
  id          String          @id @default(cuid())
  paqueteId   String
  paquete     ContratoPaquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  codigoCUPS  String?
  descripcion String
  cantidad    Float           @default(1)
  precioUnit  Float           @default(0)
  esPrincipal Boolean         @default(false)
  createdAt   DateTime        @default(now())

  @@index([paqueteId])
}

model ContratoBeneficiario {
  id         String    @id @default(cuid())
  contratoId String
  contrato   Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pacienteId String?
  paciente   Paciente? @relation(fields: [pacienteId], references: [id])
  nombre     String
  documento  String
  tipoDoc    String    @default("CC")
  email      String?
  telefono   String?
  tipo       String    @default("BENEFICIARIO") // TITULAR, BENEFICIARIO
  estado     String    @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([contratoId])
  @@index([pacienteId])
  @@index([documento])
}

// ──────────────────────────────────────────────────────────────────────────
//  MÓDULO DE ODONTOLOGÍA (Odontograma Primera Vez + Tratamiento)
//  Cumplimiento: Res. 1995/1999, Ley 2015/2020, Res. 866/2021, Habeas Data.
//  - Catálogos parametrizables: hallazgos, estados clínicos, prioridades, riesgo
//  - Odontograma: valoración por paciente (PRIMERA_VEZ | TRATAMIENTO)
//  - Hallazgos por pieza/superficie (numeración FDI)
//  - Plan de tratamiento → procedimiento CUPS (TarifaCargo) → facturación
//  - Evolución / línea de tiempo clínica
// ──────────────────────────────────────────────────────────────────────────

// Catálogo de hallazgos odontológicos (caries, fractura, ausente, corona, etc.)
model OdontoHallazgo {
  id                String                     @id @default(cuid())
  codigo            String                     @unique
  nombre            String
  descripcion       String?
  color             String                     @default("#ef4444")
  icono             String?
  generaTratamiento Boolean                    @default(true)
  prioridadDefault  String?
  categoria         String?
  orden             Int                        @default(0)
  activo            Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sugerencias       OdontoHallazgoSugerencia[]
  piezas            OdontoPiezaHallazgo[]
  planItems         OdontoPlanItem[]

  @@index([activo])
  @@index([categoria])
}

model OdontoHallazgoSugerencia {
  id         String         @id @default(cuid())
  hallazgoId String
  cargoId    String
  porDefecto Boolean        @default(false)
  createdAt  DateTime       @default(now())
  cargo      TarifaCargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  hallazgo   OdontoHallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)

  @@unique([hallazgoId, cargoId])
  @@index([hallazgoId])
  @@index([cargoId])
}

model OdontoEstado {
  id        String                @id @default(cuid())
  codigo    String                @unique
  nombre    String
  color     String                @default("#22c55e")
  orden     Int                   @default(0)
  activo    Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  piezas    OdontoPiezaHallazgo[]

  @@index([activo])
}

model OdontoPrioridad {
  id        String           @id @default(cuid())
  codigo    String           @unique
  nombre    String
  color     String           @default("#f59e0b")
  nivel     Int              @default(0)
  orden     Int              @default(0)
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  planItems OdontoPlanItem[]

  @@index([activo])
}

model OdontoRiesgo {
  id           String        @id @default(cuid())
  codigo       String        @unique
  nombre       String
  color        String        @default("#3b82f6")
  orden        Int           @default(0)
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  odontogramas Odontograma[]

  @@index([activo])
}

model Odontograma {
  id                 String                @id @default(cuid())
  pacienteId         String
  medicoId           String?
  historiaClinicaId  String?
  citaId             String?
  tipo               String                @default("PRIMERA_VEZ")
  denticion          String                @default("PERMANENTE")
  estado             String                @default("EN_PROCESO")
  hallazgosGenerales Json?
  estetica           Json?
  resumenIA          String?
  riesgoId           String?
  firmado            Boolean               @default(false)
  hashIntegridad     String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  evoluciones        OdontoEvolucion[]
  piezas             OdontoPiezaHallazgo[]
  planItems          OdontoPlanItem[]
  medico             User?                 @relation(fields: [medicoId], references: [id])
  paciente           Paciente              @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  riesgo             OdontoRiesgo?         @relation(fields: [riesgoId], references: [id])

  @@index([pacienteId])
  @@index([tipo])
  @@index([estado])
  @@index([medicoId])
}

model OdontoPiezaHallazgo {
  id            String         @id @default(cuid())
  odontogramaId String
  diente        Int
  superficie    String?
  hallazgoId    String
  estadoId      String?
  observaciones String?
  colorOverride String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  estado        OdontoEstado?  @relation(fields: [estadoId], references: [id])
  hallazgo      OdontoHallazgo @relation(fields: [hallazgoId], references: [id])
  odontograma   Odontograma    @relation(fields: [odontogramaId], references: [id], onDelete: Cascade)

  @@index([odontogramaId])
  @@index([diente])
  @@index([hallazgoId])
