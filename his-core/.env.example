# ===================================================
# SARAI HIS CORE - CONFIGURACIÓN DE ENTORNO
# ===================================================

# Configuración de Aplicación
NODE_ENV=development
PORT=3000
APP_NAME=SARAI-HIS-Core
BASE_DOMAIN=hisapp.local

# Conexión Base de Datos Maestra (his_master)
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=postgres
MASTER_DB_NAME=his_master
MASTER_DB_SSL=false
MASTER_DB_POOL_MAX=20
MASTER_DB_POOL_MIN=5

# Seguridad & Autenticación
JWT_SECRET=super_secret_jwt_key_his_sarai_2026_enterprise
JWT_EXPIRES_IN=24h

# Configuración DigitalOcean Spaces (API S3 compatible)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com  # Ajustar a la región contratada
SPACES_REGION=nyc3
SPACES_BUCKET=his-production-storage
SPACES_KEY=DO00EXAMPLEKEY1234
SPACES_SECRET=secretKeyEjemploParaDigitalOceanSpacesABC123
SPACES_PRESIGNED_EXPIRES_IN=900  # 15 minutos (900 segundos) para cumplimiento de sesión segura

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=