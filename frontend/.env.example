# Variables de entorno para el Frontend (Vite)
# Copiar este archivo a .env y completar con valores reales
# IMPORTANTE: En Vercel, configurar estas variables en:
#   Project Settings → Environment Variables

# URL del backend desplegado en Vercel
# En desarrollo usa el proxy de vite (localhost:3001)
# En producción apunta al backend de Vercel
VITE_API_URL=https://sarai-app-backend.vercel.app/api
VITE_WHISPER_URL=https://sarai-app-backend.vercel.app

# EmailJS — Formulario de contacto en /propuesta-indigo
# Crear cuenta en https://www.emailjs.com (gratis hasta 200 correos/mes)
# 1. Crear un "Email Service" conectado a su cuenta Gmail/Outlook
# 2. Crear un "Email Template" con variables: from_name, institucion, cargo, reply_to, telefono, message
# 3. Copiar los IDs aquí y agregarlos en Vercel → Settings → Environment Variables
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
