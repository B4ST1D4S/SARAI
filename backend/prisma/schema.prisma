// ============================================
// CUPS - CLASIFICACIÓN ÚNICA DE PROCEDIMIENTOS EN SALUD
// Catálogo oficial según Resolución 2706 de 2025 (Min. Salud Colombia)
// Anexo Técnico 2 "Lista Tabular".
//
// Estructura jerárquica del código (máx. 6 caracteres) — formato XX.X.X.XX:
//   GRUPO        = 2 primeros caracteres (corresponde al capítulo)
//   SUBGRUPO     = 3er carácter
//   CATEGORÍA    = 4to carácter
//   SUBCATEGORÍA = 2 últimos caracteres (procedimiento específico/facturable)
// ============================================

enum CupsNivel {
  GRUPO
  SUBGRUPO
  CATEGORIA
  SUBCATEGORIA
}

model CupsCodigo {
  id String @id @default(cuid())

  // Código sin separadores, normalizado (ej. "010101")
  codigo        String    @unique
  // Código con separadores tal como aparece en la lista tabular (ej. "01.0.1.01")
  codigoFormato String
  nivel         CupsNivel
  descripcion   String

  // Desglose jerárquico de la codificación
  seccion      String // "00" quirúrgicos | "01" no quirúrgicos
  capitulo     String // "01".."24"
  grupo        String // 2 caracteres (= capítulo)
  subgrupo     String? // 1 carácter
  categoria    String? // 1 carácter
  subcategoria String? // 2 caracteres

  // Árbol jerárquico (auto-relación)
  parentId String?
  parent   CupsCodigo?  @relation("CupsJerarquia", fields: [parentId], references: [id], onDelete: Cascade)
  hijos    CupsCodigo[] @relation("CupsJerarquia")

  // Anotaciones de la lista tabular
  incluye String?
  excluye String?
  nota    String?

  // Solo las SUBCATEGORÍA son procedimientos reportables/facturables
  esFacturable Boolean @default(false)
  activo       Boolean @default(true)
  // Resolución/versión de origen del registro
  version      String  @default("Resolucion 2706 de 2025")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nivel])
  @@index([seccion])
  @@index([capitulo])
  @@index([grupo])
  @@index([parentId])
  @@index([esFacturable])
  @@index([activo])
  cargos TarifaCargo[]
}

// ──────────────────────────────────────────────────────────────────────────
//  MÓDULO DE TARIFAS / TARIFARIOS (Parametrización)
//  Inspirado en el módulo Tarifario del SIIS, modernizado para SARAI.
//  - Clasificación: TarifaGrupo → TarifaTipo
//  - Cargo: servicio/ítem interno con equivalencia al catálogo CUPS (Res. 2706)
//  - Tarifario: lista de precios; puede derivarse de otra aplicando un %
//  - TarifaItem: precio de un cargo dentro de un tarifario
// ──────────────────────────────────────────────────────────────────────────

model TarifaGrupo {
  id        String       @id @default(cuid())
  codigo    String       @unique
  nombre    String
  activo    Boolean      @default(true)
  tipos     TarifaTipo[]
  cargos    TarifaCargo[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([activo])
}

model TarifaTipo {
  id        String      @id @default(cuid())
  codigo    String
  nombre    String
  activo    Boolean     @default(true)
  grupoId   String
  grupo     TarifaGrupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  cargos    TarifaCargo[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([grupoId, codigo])
  @@index([grupoId])
  @@index([activo])
}

model TarifaCargo {
  id          String  @id @default(cuid())
  // Código interno propio de la clínica (único)
  codigo      String  @unique
  descripcion String

  // Equivalencia con el catálogo CUPS oficial (Res. 2706/2025)
  cupsCodigoId  String?
  cupsCodigo    CupsCodigo? @relation(fields: [cupsCodigoId], references: [id])
  cupsCodigoStr String? // código CUPS sin puntos (para búsqueda/importación)

  // Clasificación
  grupoId String?
  grupo   TarifaGrupo? @relation(fields: [grupoId], references: [id])
  tipoId  String?
  tipo    TarifaTipo?  @relation(fields: [tipoId], references: [id])

  // Atributos adicionales (compatibles con el legado)
  nivel        String? // nivel de complejidad
  tipoUnidad   String?
  conceptoRips String?

  activo    Boolean      @default(true)
  items     TarifaItem[]
  cuentaItems CuentaItem[]
  odontoPlanItems    OdontoPlanItem[]
  odontoSugerencias  OdontoHallazgoSugerencia[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([cupsCodigoId])
  @@index([grupoId])
  @@index([tipoId])
  @@index([activo])
}

model Tarifario {
  id          String  @id @default(cuid())
  codigo      String  @unique
  nombre      String
  descripcion String?
  tipo        String? // PARTICULAR, EPS, SOAT, PREPAGADA, etc.

  // Derivación por porcentaje sobre un tarifario base
  baseId     String?
  base       Tarifario?  @relation("TarifarioBase", fields: [baseId], references: [id])
  derivados  Tarifario[] @relation("TarifarioBase")
  porcentaje Float? // % aplicado sobre el tarifario base (ej. 110 = +10%)

  vigenciaDesde DateTime?
  vigenciaHasta DateTime?
  activo        Boolean      @default(true)
  items         TarifaItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([activo])
  @@index([baseId])
}

model TarifaItem {
  id          String    @id @default(cuid())
  tarifarioId String
  tarifario   Tarifario @relation(fields: [tarifarioId], references: [id], onDelete: Cascade)
  cargoId     String
  cargo       TarifaCargo @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  precio      Float
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tarifarioId, cargoId])
  @@index([tarifarioId])
  @@index([cargoId])
}

// ──────────────────────────────────────────────────────────────────────────
//  MÓDULO DE FACTURACIÓN (demo funcional)
//  Flujo: al COMPLETAR una cita se crea un Ingreso + Cuenta (ABIERTA).
//  A la cuenta se le adicionan ítems/servicios (cargos). Luego se factura.
//  - Ingreso: admisión del paciente (ambulatorio/hospitalario)
//  - Cuenta: documento de cargos de un ingreso
//  - CuentaItem: cada servicio/cargo con cantidad y precio
//  - Factura: documento de venta generado a partir de una cuenta
// ──────────────────────────────────────────────────────────────────────────

model Ingreso {
  id            String    @id @default(cuid())
  numero        Int       @unique @default(autoincrement())
  pacienteId    String
  paciente      Paciente  @relation(fields: [pacienteId], references: [id])
  citaId        String?
  cita          Cita?     @relation(fields: [citaId], references: [id])
  medicoId      String?
  medico        User?     @relation(fields: [medicoId], references: [id])
  tipoIngreso   String    @default("AMBULATORIO") // AMBULATORIO, HOSPITALARIO, URGENCIAS
  entidad       String?   // responsable / EPS / aseguradora
  plan          String?   // plan de la cuenta
  estado        String    @default("ACTIVO") // ACTIVO, CERRADO, ANULADO
  fechaIngreso  DateTime  @default(now())
  fechaEgreso   DateTime?
  observaciones String?
  cuentas       Cuenta[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pacienteId])
  @@index([citaId])
  @@index([estado])
}

model Cuenta {
  id            String       @id @default(cuid())
  numero        Int          @unique @default(autoincrement())
  ingresoId     String
  ingreso       Ingreso      @relation(fields: [ingresoId], references: [id], onDelete: Cascade)
  estado        String       @default("ABIERTA") // ABIERTA, FACTURADA, ANULADA
  observaciones String?
  items         CuentaItem[]
  factura       Factura?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([ingresoId])
  @@index([estado])
}

model CuentaItem {
  id             String       @id @default(cuid())
  cuentaId       String
  cuenta         Cuenta       @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  cargoId        String?
  cargo          TarifaCargo? @relation(fields: [cargoId], references: [id])
  codigo         String?      // snapshot del código del cargo/CUPS
  descripcion    String
  departamento   String?      // ASISTENCIAL, LABORATORIO, IMAGENOLOGIA, etc.
  cantidad       Float        @default(1)
  precioUnitario Float        @default(0)
  valorTotal     Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([cuentaId])
  @@index([cargoId])
}

model Factura {
  id            String   @id @default(cuid())
  numero        Int      @unique @default(autoincrement())
  prefijo       String   @default("FE")
  cuentaId      String   @unique
  cuenta        Cuenta   @relation(fields: [cuentaId], references: [id])
  pacienteId    String
  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  entidad       String?
  plan          String?
  subtotal      Float    @default(0)
  total         Float    @default(0)
  estado        String   @default("EMITIDA") // EMITIDA, ANULADA, PAGADA
  observaciones String?
  fecha         DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pacienteId])
  @@index([estado])
  @@index([fecha])
}

// ──────────────────────────────────────────────────────────────────────────
//  MÓDULO DE ODONTOLOGÍA (Odontograma Primera Vez + Tratamiento)
//  Cumplimiento: Res. 1995/1999, Ley 2015/2020, Res. 866/2021, Habeas Data.
//  - Catálogos parametrizables: hallazgos, estados clínicos, prioridades, riesgo
//  - Odontograma: valoración por paciente (PRIMERA_VEZ | TRATAMIENTO)
//  - Hallazgos por pieza/superficie (numeración FDI)
//  - Plan de tratamiento → procedimiento CUPS (TarifaCargo) → facturación
//  - Evolución / línea de tiempo clínica
// ──────────────────────────────────────────────────────────────────────────

// Catálogo de hallazgos odontológicos (caries, fractura, ausente, corona, etc.)
model OdontoHallazgo {
  id               String  @id @default(cuid())
  codigo           String  @unique
  nombre           String
  descripcion      String?
  // Color visual para representar el hallazgo en el odontograma (hex)
  color            String  @default("#ef4444")
  icono            String? // nombre de icono lucide opcional
  // Si true, este hallazgo genera automáticamente un ítem en el plan de tratamiento
  generaTratamiento Boolean @default(true)
  // Prioridad sugerida por defecto al generar tratamiento
  prioridadDefault String? // referencia a OdontoPrioridad.codigo
  // Categoría: PATOLOGIA, RESTAURACION, PROTESIS, ENDODONCIA, PERIODONCIA, etc.
  categoria        String?
  orden            Int     @default(0)
  activo           Boolean @default(true)
  sugerencias      OdontoHallazgoSugerencia[]
  piezas           OdontoPiezaHallazgo[]
  planItems        OdontoPlanItem[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([activo])
  @@index([categoria])
}

// Sugerencias de procedimientos CUPS por hallazgo (mapeo hallazgo → cargo facturable)
model OdontoHallazgoSugerencia {
  id          String         @id @default(cuid())
  hallazgoId  String
  hallazgo    OdontoHallazgo @relation(fields: [hallazgoId], references: [id], onDelete: Cascade)
  cargoId     String
  cargo       TarifaCargo    @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  porDefecto  Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@unique([hallazgoId, cargoId])
  @@index([hallazgoId])
  @@index([cargoId])
}

// Catálogo de estados clínicos (Sano, Caries, Tratado, Ausente, etc.)
model OdontoEstado {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  color     String   @default("#22c55e")
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  piezas    OdontoPiezaHallazgo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

// Catálogo de prioridades (Urgente, Alta, Media, Baja)
model OdontoPrioridad {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  color     String   @default("#f59e0b")
  nivel     Int      @default(0) // mayor = más urgente
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  planItems OdontoPlanItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

// Catálogo de riesgo clínico (Bajo, Moderado, Alto)
model OdontoRiesgo {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  color     String   @default("#3b82f6")
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  odontogramas Odontograma[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

// Odontograma: valoración odontológica de un paciente
model Odontograma {
  id                 String   @id @default(cuid())
  pacienteId         String
  paciente           Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  medicoId           String?
  medico             User?    @relation(fields: [medicoId], references: [id])
  historiaClinicaId  String?
  citaId             String?
  tipo               String   @default("PRIMERA_VEZ") // PRIMERA_VEZ | TRATAMIENTO
  denticion          String   @default("PERMANENTE")  // PERMANENTE | TEMPORAL | MIXTA
  estado             String   @default("EN_PROCESO")  // EN_PROCESO | FINALIZADO | ARCHIVADO
  // Hallazgos generales: higiene oral, periodontal, oclusión, ATM, observaciones
  hallazgosGenerales Json?
  // Sección estética (sonrisa, color, alineación, etc.)
  estetica           Json?
  // Resumen clínico generado/asistido por SARAI
  resumenIA          String?
  riesgoId           String?
  riesgo             OdontoRiesgo? @relation(fields: [riesgoId], references: [id])
  firmado            Boolean  @default(false)
  hashIntegridad     String?
  piezas             OdontoPiezaHallazgo[]
  planItems          OdontoPlanItem[]
  evoluciones        OdontoEvolucion[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([pacienteId])
  @@index([tipo])
  @@index([estado])
  @@index([medicoId])
}

// Hallazgo registrado sobre una pieza dental (o superficie específica)
model OdontoPiezaHallazgo {
  id            String        @id @default(cuid())
  odontogramaId String
  odontograma   Odontograma   @relation(fields: [odontogramaId], references: [id], onDelete: Cascade)
  diente        Int           // numeración FDI (11..48 / 51..85)
  // Superficie: null = pieza completa | VESTIBULAR, LINGUAL, PALATINA, MESIAL, DISTAL, OCLUSAL, INCISAL
  superficie    String?
  hallazgoId    String
  hallazgo      OdontoHallazgo @relation(fields: [hallazgoId], references: [id])
  estadoId      String?
  estado        OdontoEstado?  @relation(fields: [estadoId], references: [id])
  observaciones String?
  colorOverride String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([odontogramaId])
  @@index([diente])
  @@index([hallazgoId])
}

// Ítem del plan de tratamiento (sirve para Primera Vez y seguimiento de Tratamiento)
model OdontoPlanItem {
  id                     String         @id @default(cuid())
  odontogramaId          String
  odontograma            Odontograma    @relation(fields: [odontogramaId], references: [id], onDelete: Cascade)
  pacienteId             String
  paciente               Paciente       @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  diente                 Int?
  superficie             String?
  hallazgoId             String?
  hallazgo               OdontoHallazgo? @relation(fields: [hallazgoId], references: [id])
  diagnostico            String
  // Procedimiento facturable (CUPS) — se consume del catálogo de cargos/tarifas
  cargoId                String?
  cargo                  TarifaCargo?   @relation(fields: [cargoId], references: [id])
  codigoCups             String?
  descripcionProcedimiento String
  prioridadId            String?
  prioridad              OdontoPrioridad? @relation(fields: [prioridadId], references: [id])
  // Estado del tratamiento
  estadoTratamiento      String         @default("PLANEADO") // PLANEADO | AGENDADO | EN_TRATAMIENTO | FINALIZADO | SUSPENDIDO | CANCELADO
  medicoId               String?
  observaciones          String?
  evolucion              String?
  precio                 Float          @default(0)
  fechaProgramada        DateTime?
  fechaEjecucion         DateTime?
  // Integración con facturación (evita duplicar cargos)
  cuentaItemId           String?
  facturado              Boolean        @default(false)
  orden                  Int            @default(0)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([odontogramaId])
  @@index([pacienteId])
  @@index([estadoTratamiento])
  @@index([cargoId])
}

// Evolución / línea de tiempo clínica del tratamiento
model OdontoEvolucion {
  id            String       @id @default(cuid())
  odontogramaId String
  odontograma   Odontograma  @relation(fields: [odontogramaId], references: [id], onDelete: Cascade)
  pacienteId    String
  paciente      Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  planItemId    String?
  // Tipo: VALORACION | PLANIFICACION | PROCEDIMIENTO | CONTROL | ALTA | NOTA
  tipo          String       @default("NOTA")
  descripcion   String
  medicoId      String?
  fecha         DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([odontogramaId])
  @@index([pacienteId])
  @@index([fecha])
}
